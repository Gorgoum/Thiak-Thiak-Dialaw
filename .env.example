# Connexion PostgreSQL (la base sera créée automatiquement par "npm run init-db")
DATABASE_URL=postgresql://postgres:MOT_DE_PASSE@localhost:5432/thiak_thiak

PORT=3000
# Mettre une longue chaîne aléatoire
JWT_SECRET=a-remplacer-par-une-longue-chaine-aleatoire

# Compte administrateur créé par "npm run init-db"
ADMIN_NOM=Administrateur
ADMIN_TEL=770000000
ADMIN_PIN=0000

# Notifications Web Push : laissez vide, les clés sont générées automatiquement dans .vapid.json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@thiakthiak.sn

# Paiement en ligne Wave / Orange Money avec Nangu (laisser vide = espèces uniquement)
NANGU_API_URL=https://api.nangu-pay.workers.dev
# Console Nangu → Développeurs → Clés d'API : sk_test_… pour essayer, sk_live_… en production
NANGU_SECRET_KEY=
# Secret whsec_… affiché une fois à la déclaration du webhook https://<votre-adresse>/webhooks/nangu
NANGU_WEBHOOK_SECRET=
# Moyens proposés aux clients : wave, orange_money (Orange exige un code marchand déclaré chez Nangu)
NANGU_PROVIDERS=wave,orange_money
